---
import PageLayout from '../../layouts/PageLayout.astro';
import Gallery from '../../components/Gallery.astro';
import Approach from '../../components/Approach.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { getCollection } from 'astro:content';
import { getSite } from '../../utils/consts';

const site = await getSite();

const photographyEntry = await getCollection('galleryPhotography');
const photographyImages = (photographyEntry[0]?.data || []).map((img) => ({
	src: img.image,
	alt: img.alt,
}));

const designEntry = await getCollection('galleryDesign');
const designImages = (designEntry[0]?.data || []).map((img) => ({
	src: img.image,
	alt: img.alt,
}));

const freelanceEntry = await getCollection('galleryFreelance');
const freelanceImages = (freelanceEntry[0]?.data || []).map((img) => ({
	src: img.image,
	alt: img.alt,
}));

const approachItems = (await getCollection('approach'))[0]?.data || [];
const contact = (await getCollection('contact'))[0]?.data;
---

<PageLayout title={`My Work · ${site.author.name}`} description="Marketing, packaging, and freelance work.">
	<section class="section-block" data-reveal>
		<h1 class="tone-headline">
			<span>Ideas</span>
			<span><span class="muted-word">Framed</span> With</span>
			<span>Intention</span>
		</h1>
		<div class="work-links">
			<a href="#marketing" class="pill">Marketing</a>
			<a href="#packaging" class="pill">Packaging</a>
			<a href="#freelance" class="pill">Freelance</a>
		</div>
	</section>

	<section id="marketing" class="section-block" data-reveal>
		<h2 class="display-heading">Marketing</h2>
		<Gallery images={designImages} initialVisible={4} columns={2} />
	</section>

	<section id="packaging" class="section-block" data-reveal>
		<h2 class="display-heading">Packaging</h2>
		<Gallery images={photographyImages} initialVisible={4} columns={2} />
	</section>

	<section id="freelance" class="section-block" data-reveal>
		<h2 class="display-heading">Freelance</h2>
		<Gallery images={freelanceImages} initialVisible={4} columns={2} />
	</section>

	<div class="section-block">
		<Approach items={approachItems} />
	</div>

	<div class="section-block">
		<ContactCTA heading={contact?.heading} image={designImages[2]} />
	</div>
</PageLayout>
