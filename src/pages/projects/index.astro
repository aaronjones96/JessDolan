---
import PageLayout from '../../layouts/PageLayout.astro';
import Gallery from '../../components/Gallery.astro';
import Approach from '../../components/Approach.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { getCollection } from 'astro:content';
import { getSite } from '../../utils/consts';

const site = await getSite();

const photographyEntry = await getCollection('galleryPhotography');
const photographyImages = (photographyEntry[0]?.data || []).map((img) => ({
	src: img.image,
	alt: img.alt,
}));

const designEntry = await getCollection('galleryDesign');
const designImages = (designEntry[0]?.data || []).map((img) => ({
	src: img.image,
	alt: img.alt,
}));

const approachItems = (await getCollection('approach'))[0]?.data || [];
const contact = (await getCollection('contact'))[0]?.data;
---

<PageLayout title={`My Work · ${site.author.name}`} description="Design and photography work.">
	{/* <div class="work-filters" data-reveal>
		<div class="pill-group">
			<a href="#design" class="pill hover:text-ink transition-colors">Design</a>
			<a href="#photography" class="pill hover:text-ink transition-colors">Photography</a>
		</div>
		<select id="work-jump" aria-label="Jump to section">
			<option value="#design">Design</option>
			<option value="#photography">Photography</option>
		</select>
	</div> */}

	<section class="section-block" data-reveal>
		<h1 class="tone-headline">
			<span>Ideas</span>
			<span><span class="muted-word">Framed</span> With</span>
			<span>Intention</span>
		</h1>
	</section>

	<section id="design" class="section-block" data-reveal>
		<h2 class="display-heading">Design</h2>
		<Gallery images={designImages} initialVisible={10} columns={2} />
	</section>

	<section id="photography" class="section-block" data-reveal>
		<h2 class="display-heading">Photography</h2>
		<Gallery images={photographyImages} initialVisible={10} columns={2} />
	</section>

	<div class="section-block">
		<Approach items={approachItems} />
	</div>

	<div class="section-block">
		<ContactCTA heading={contact?.heading} image={designImages[2]} />
	</div>
</PageLayout>

<script is:inline>
	document.getElementById('work-jump')?.addEventListener('change', (e) => {
		const target = e.target;
		if (!(target instanceof HTMLSelectElement)) return;
		document.querySelector(target.value)?.scrollIntoView({ behavior: 'smooth' });
	});
</script>
