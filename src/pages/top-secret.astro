---
import PageLayout from '../layouts/PageLayout.astro';
import { getSite } from '../utils/consts';
import { getCollection } from 'astro:content';

const site = await getSite();

const cv = (await getCollection('cv'))[0]?.data;
const experience = cv?.experience || [];
const education = cv?.education || [];
const skills = cv?.skills || [];
---

<PageLayout title="Top Secret" description="Classified." noindex>
	<div class="secret-scene" id="secret-scene">
		<div class="secret-hint" id="secret-hint">Search the dark&hellip;</div>

		<button type="button" class="secret-folder-wrap" id="secret-image-wrap" aria-label="You found it — click to reveal">
			<div class="secret-folder">
				<div class="folder-tab"></div>
				<div class="folder-body">
					<span class="folder-stamp">Top Secret</span>
				</div>
			</div>
		</button>

		<div class="secret-cv" id="secret-cv" aria-hidden="true">
			<div class="cv-card">
				<button type="button" class="cv-close" id="cv-close" aria-label="Close CV">&times;</button>
				<div class="cv-header">
					<p class="cv-stamp">Declassified</p>
					<h2 class="cv-name">{site.author.name}</h2>
					<p class="cv-role">{site.author.role} — {site.author.location}</p>
				</div>

				<div class="cv-columns">
					<section class="cv-section">
						<h3>Experience</h3>
						{experience.map((item) => (
							<div class="cv-item">
								<p class="cv-item-date">{item.datetime}</p>
								<p class="cv-item-title">{item.title}</p>
								<p class="cv-item-desc">{item.description}</p>
							</div>
						))}
					</section>

					<section class="cv-section">
						<h3>Education</h3>
						{education.map((item) => (
							<div class="cv-item">
								<p class="cv-item-date">{item.datetime}</p>
								<p class="cv-item-title">{item.title}</p>
								<p class="cv-item-desc">{item.description}</p>
							</div>
						))}

						<h3 class="cv-skills-heading">Skills</h3>
						<ul class="cv-skills">
							{skills.map((skill) => <li>{skill}</li>)}
						</ul>
					</section>
				</div>
			</div>
		</div>

		<div class="flashlight-glow" id="flashlight-glow"></div>
		<div class="flashlight-overlay" id="flashlight-overlay"></div>
	</div>
</PageLayout>

<script>
	function initSecretScene() {
		const scene = document.getElementById('secret-scene');
		const imageWrap = document.getElementById('secret-image-wrap');
		const cv = document.getElementById('secret-cv');
		const cvClose = document.getElementById('cv-close');
		if (!(scene instanceof HTMLElement)) return;

		let revealed = false;

		const setLight = (clientX: number, clientY: number) => {
			const rect = scene.getBoundingClientRect();
			const x = clientX - rect.left;
			const y = clientY - rect.top;
			scene.style.setProperty('--mx', x + 'px');
			scene.style.setProperty('--my', y + 'px');
		};

		scene.addEventListener('mousemove', (e) => setLight(e.clientX, e.clientY));
		scene.addEventListener(
			'touchmove',
			(e) => {
				const t = e.touches[0];
				if (t) setLight(t.clientX, t.clientY);
			},
			{ passive: true }
		);

		const reveal = () => {
			if (revealed) return;
			revealed = true;
			scene.classList.add('is-revealed');
			cv?.classList.add('is-visible');
			cv?.setAttribute('aria-hidden', 'false');
		};

		const close = () => {
			revealed = false;
			scene.classList.remove('is-revealed');
			cv?.classList.remove('is-visible');
			cv?.setAttribute('aria-hidden', 'true');
		};

		imageWrap?.addEventListener('click', reveal);
		cvClose?.addEventListener('click', close);
	}

	initSecretScene();
	document.addEventListener('astro:after-swap', initSecretScene);
</script>
