---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Work from '../components/Work.astro';
import Approach from '../components/Approach.astro';
import ContactCTA from '../components/ContactCTA.astro';
import invertedLogo from '../assets/Logo/JD LOGO Inverted.png';

import { getCollection } from 'astro:content';
import { getSite } from '../utils/consts';

const site = await getSite();

const photographyEntry = await getCollection('galleryPhotography');
const photographyImages = (photographyEntry[0]?.data || []).map((img) => ({
	src: img.image,
	alt: img.alt,
}));

const designEntry = await getCollection('galleryDesign');
const designImages = (designEntry[0]?.data || []).map((img) => ({
	src: img.image,
	alt: img.alt,
}));

const about = (await getCollection('about'))[0]?.data;
const workSection = (await getCollection('workSection'))[0]?.data;
const approachItems = (await getCollection('approach'))[0]?.data || [];
const contact = (await getCollection('contact'))[0]?.data;
---

<PageLayout
	title={site.author.name || 'Dasein'}
>
	<Hero
		title={site.author.name || 'Dasein'}
		role={site.author.role}
		description={site.author.bio}
		location={site.author.location}
		image={{ src: invertedLogo, alt: `${site.author.name} logo` }}
	/>

	<div class="section-block">
		<About
			label="Behind the Lens"
			intro={about?.intro}
			process={about?.approach}
			images={[designImages[0], photographyImages[1]]}
		/>
	</div>

	<div class="section-block" id="gallery">
		<Work
			entries={[
				{
					title: 'Design',
					description: workSection?.designBlurb,
					href: '/projects#design',
					images: designImages.slice(0, 3),
				},
				{
					title: 'Photography',
					description: workSection?.photographyBlurb,
					href: '/projects#photography',
					images: photographyImages.slice(2, 5),
				},
			]}
		/>
	</div>

	<div class="section-block">
		<Approach items={approachItems} />
	</div>

	<div class="section-block">
		<ContactCTA heading={contact?.heading} image={designImages[1]} />
	</div>
</PageLayout>
