---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';
import PostList from '../components/PostList.astro';
import SectionList from "../components/SectionList.astro";
import Gallery from '../components/Gallery.astro';

import { getCollection } from "astro:content";
import { getSite } from '../utils/consts';
import Social from '../components/Social.astro';

const cv = (await getCollection("cv" as any)) as any[];

const site = await getSite();

// Import all photography images
const photographyGlob = import.meta.glob<{ default: ImageMetadata }>('../assets/Photography files/*.png', { eager: true });
const photographyImages = Object.entries(photographyGlob)
	.sort((a, b) => {
		const numA = parseInt(a[0].match(/(\d+)\.png$/)?.[1] || '0');
		const numB = parseInt(b[0].match(/(\d+)\.png$/)?.[1] || '0');
		return numA - numB;
	})
	.map(([path, module], index) => ({
		src: module.default,
		alt: `Photography ${index + 1}`
	}));

// Import all design images (excluding PDF)
const designGlob = import.meta.glob<{ default: ImageMetadata }>('../assets/Design/*.png', { eager: true });
const designImages = Object.entries(designGlob)
	.sort((a, b) => {
		const numA = parseInt(a[0].match(/(\d+)\.png$/)?.[1] || '0');
		const numB = parseInt(b[0].match(/(\d+)\.png$/)?.[1] || '0');
		return numA - numB;
	})
	.map(([path, module], index) => ({
		src: module.default,
		alt: `Design ${index + 1}`
	}));
---

<PageLayout
	title={site.author.name || 'Dasein'}
>
	<Hero
		title={site.author.name || 'Dasein'}
		description={site.author.bio || 'Welcome to my personal website.'}
		role={site.author.role}
		location={site.author.location}
		actions={[
			{ label: 'View Blog', href: '/blog' },
			{ label: 'Get Quote', href: '/contact' },
		]}
	/>

	<section id="gallery">
		<Gallery title="Design" images={designImages} initialVisible={8} columns={4} />
	</section>

	<section>
		<Gallery title="Photography" images={photographyImages} initialVisible={8} columns={4} />
	</section>

	<Social class="mt-8" />

	<PostList
		heading="Projects"
		limit={3}
		viewAllHref="/blog"
	/>

