---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Work from '../components/Work.astro';
import Approach from '../components/Approach.astro';
import ContactCTA from '../components/ContactCTA.astro';
import logo from '../assets/Logo/JD LOGO.png';
import invertedLogo from '../assets/Logo/JD LOGO Inverted.png';

import { getCollection } from 'astro:content';
import { getSite } from '../utils/consts';

const site = await getSite();

const photographyEntry = await getCollection('galleryPhotography');
const photographyImages = (photographyEntry[0]?.data || []).map((img) => ({
	src: img.image,
	alt: img.alt,
}));

const designEntry = await getCollection('galleryDesign');
const designImages = (designEntry[0]?.data || []).map((img) => ({
	src: img.image,
	alt: img.alt,
}));

const freelanceEntry = await getCollection('galleryFreelance');
const freelanceImages = (freelanceEntry[0]?.data || []).map((img) => ({
	src: img.image,
	alt: img.alt,
}));

const about = (await getCollection('about'))[0]?.data;
const aboutImages = (about?.images || []).map((img) => ({
	src: img.image,
	alt: img.alt,
}));
const workSection = (await getCollection('workSection'))[0]?.data;
const approachItems = (await getCollection('approach'))[0]?.data || [];
const contact = (await getCollection('contact'))[0]?.data;
---

<PageLayout
	title={site.author.name || 'Dasein'}
	description={about?.intro || site.author.bio}
>
	<Hero
		title={site.author.name || 'Dasein'}
		role={site.author.role}
		description={site.author.bio}
		location={site.author.location}
		image={{ src: logo, alt: `${site.author.name} logo` }}
		imageDark={{ src: invertedLogo, alt: `${site.author.name} logo` }}
	/>

	<div class="section-block">
		<About
			label="Behind the Lens"
			intro={about?.intro}
			process={about?.approach}
			images={aboutImages}
		/>
	</div>

	<div class="section-block" id="gallery">
		<Work
			entries={[
				{
					title: 'Marketing',
					description: workSection?.marketingBlurb,
					href: '/projects#marketing',
					images: designImages.slice(0, 3),
				},
				{
					title: 'Packaging',
					description: workSection?.packagingBlurb,
					href: '/projects#packaging',
					images: photographyImages.slice(2, 5),
				},
				{
					title: 'Freelance',
					description: workSection?.freelanceBlurb,
					href: '/projects#freelance',
					images: freelanceImages.slice(0, 3),
				},
			]}
		/>
	</div>

	<div class="section-block">
		<Approach items={approachItems} />
	</div>

	<div class="section-block">
		<ContactCTA heading={contact?.heading} image={contact?.image ? { src: contact.image, alt: contact.imageAlt || '' } : undefined} />
	</div>
</PageLayout>
