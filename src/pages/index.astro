---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';
import PostList from '../components/PostList.astro';
import SectionList from "../components/SectionList.astro";
import Gallery from '../components/Gallery.astro';

import { getCollection } from "astro:content";
import { getSite } from '../utils/consts';
import Social from '../components/Social.astro';

const cv = (await getCollection("cv" as any)) as any[];

const site = await getSite();

const photographyImages = [
	{ src: "https://picsum.photos/seed/photo1/800/800", alt: "Photography 1" },
	{ src: "https://picsum.photos/seed/photo2/800/800", alt: "Photography 2" },
	{ src: "https://picsum.photos/seed/photo3/800/800", alt: "Photography 3" },
	{ src: "https://picsum.photos/seed/photo4/800/800", alt: "Photography 4" },
	{ src: "https://picsum.photos/seed/photo5/800/800", alt: "Photography 5" },
	{ src: "https://picsum.photos/seed/photo6/800/800", alt: "Photography 6" },
	{ src: "https://picsum.photos/seed/photo7/800/800", alt: "Photography 7" },
	{ src: "https://picsum.photos/seed/photo8/800/800", alt: "Photography 8" },
	{ src: "https://picsum.photos/seed/photo9/800/800", alt: "Photography 9" },
	{ src: "https://picsum.photos/seed/photo10/800/800", alt: "Photography 10" },
	{ src: "https://picsum.photos/seed/photo11/800/800", alt: "Photography 11" },
	{ src: "https://picsum.photos/seed/photo12/800/800", alt: "Photography 12" },
];

const designImages = [
	{ src: "https://picsum.photos/seed/design1/800/800", alt: "Design 1" },
	{ src: "https://picsum.photos/seed/design2/800/800", alt: "Design 2" },
	{ src: "https://picsum.photos/seed/design3/800/800", alt: "Design 3" },
	{ src: "https://picsum.photos/seed/design4/800/800", alt: "Design 4" },
	{ src: "https://picsum.photos/seed/design5/800/800", alt: "Design 5" },
	{ src: "https://picsum.photos/seed/design6/800/800", alt: "Design 6" },
	{ src: "https://picsum.photos/seed/design7/800/800", alt: "Design 7" },
	{ src: "https://picsum.photos/seed/design8/800/800", alt: "Design 8" },
	{ src: "https://picsum.photos/seed/design9/800/800", alt: "Design 9" },
	{ src: "https://picsum.photos/seed/design10/800/800", alt: "Design 10" },
	{ src: "https://picsum.photos/seed/design11/800/800", alt: "Design 11" },
	{ src: "https://picsum.photos/seed/design12/800/800", alt: "Design 12" },
];
---

<PageLayout
	title={site.author.name || 'Dasein'}
>
	<Hero
		title={site.author.name || 'Dasein'}
		description={site.author.bio || 'Welcome to my personal website.'}
		role={site.author.role}
		location={site.author.location}
		actions={[
			{ label: 'View Blog', href: '/blog' },
			{ label: 'Get Quote', href: '/contact' },
		]}
	/>

	<section id="gallery">
		<Gallery title="Design" images={designImages} initialVisible={8} columns={4} />
	</section>

	<section>
		<Gallery title="Photography" images={photographyImages} initialVisible={8} columns={4} />
	</section>

	<Social class="mt-8" />

	<PostList
		heading="Projects"
		limit={3}
		viewAllHref="/blog"
	/>

