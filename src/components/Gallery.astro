---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface GalleryImage {
  src: string | ImageMetadata;
  alt: string;
}

interface Props {
  title?: string;
  images?: GalleryImage[];
  initialVisible?: number;
  columns?: 2 | 3 | 4;
}

const {
  title,
  images = [],
  initialVisible = 8,
  columns = 4
} = Astro.props;

// Helper to get the actual src string for lightbox
const getSrcString = (src: string | ImageMetadata): string => {
  if (typeof src === 'string') return src;
  return src.src;
};

const gridColsClass = {
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-2 lg:grid-cols-3',
  4: 'sm:grid-cols-2 lg:grid-cols-4',
}[columns];

const hasMore = images.length > initialVisible;
---

<div class="gallery-container max-w-360 mx-auto px-8">
  <div class="grid grid-cols-1 md:grid-cols-3 border-b py-8 border-base-200">
    {title && (
      <div class="lg:sticky lg:top-24 lg:z-40 self-start mb-6 md:mb-0">
        <h2 class="text-sm 2xl:text-xl text-base-900 font-bold uppercase">{title}</h2>
      </div>
    )}
    <div class={title ? "md:col-span-2" : "md:col-span-3"}>
      <div
        class={`gallery-grid grid grid-cols-1 ${gridColsClass} gap-4`}
        data-initial-visible={initialVisible}
      >
    {images.map((image, index) => (
      <figure
        class:list={[
          "gallery-item relative aspect-square overflow-hidden bg-[color-mix(in_oklab,var(--color-ink)_4%,var(--color-surface))] group cursor-pointer",
          index >= initialVisible && "hidden"
        ]}
        data-index={index}
        data-src={getSrcString(image.src)}
        data-alt={image.alt}
      >
        {typeof image.src === 'string' ? (
          <img
            src={image.src}
            alt={image.alt}
            loading={index < initialVisible ? "eager" : "lazy"}
            class="w-full h-full object-cover transition duration-400 group-hover:scale-105"
          />
        ) : (
          <Image
            src={image.src}
            alt={image.alt}
            loading={index < initialVisible ? "eager" : "lazy"}
            class="w-full h-full object-cover transition duration-400 group-hover:scale-105"
            widths={[400, 800]}
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"
          />
        )}
        {image.alt && (
          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/60 to-transparent p-4 text-white text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            {image.alt}
          </figcaption>
        )}
      </figure>
    ))}
  </div>

  {hasMore && (
      <div class="mt-6 text-center">
        <button
          type="button"
          class="gallery-toggle text-xs 2xl:text-lg text-base-900 hover:text-base-500 font-bold uppercase inline-block px-6 py-3 underline decoration-1 underline-offset-4 transition-colors cursor-pointer"
          data-expanded="false"
        >
          <span class="toggle-text">See More</span>
        </button>
      </div>
    )}
    </div>
  </div>

  <!-- Lightbox overlay -->
  <div class="gallery-lightbox fixed inset-0 z-50 hidden bg-black/90 backdrop-blur-sm">
    <button
      type="button"
      class="lightbox-close absolute top-4 right-4 z-10 p-2 text-white hover:text-white/70 transition-colors cursor-pointer"
      aria-label="Close lightbox"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <button
      type="button"
      class="lightbox-prev absolute left-2 md:left-4 top-1/2 -translate-y-1/2 z-10 p-2 text-white hover:text-white/70 transition-colors cursor-pointer"
      aria-label="Previous image"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
    </button>
    <button
      type="button"
      class="lightbox-next absolute right-2 md:right-4 top-1/2 -translate-y-1/2 z-10 p-2 text-white hover:text-white/70 transition-colors cursor-pointer"
      aria-label="Next image"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </button>
    <div class="lightbox-content flex items-center justify-center w-full h-full p-4 md:p-12">
      <img class="lightbox-image max-w-full max-h-full object-contain" src="" alt="" />
    </div>
    <p class="lightbox-caption absolute bottom-4 left-0 right-0 text-center text-white text-sm px-4"></p>
  </div>
</div>

<script>
  function initGallery() {
    const containers = document.querySelectorAll('.gallery-container');

    containers.forEach((container, containerIndex) => {
      const toggle = container.querySelector('.gallery-toggle') as HTMLButtonElement | null;
      const grid = container.querySelector('.gallery-grid') as HTMLElement | null;

      // Position: fixed only escapes the viewport if no ancestor has a transform
      // (scroll-reveal sections do). Move the lightbox to <body> so it always
      // covers the full viewport regardless of where the gallery is nested.
      const galleryId = container.getAttribute('data-gallery-id') || `gallery-${containerIndex}`;
      container.setAttribute('data-gallery-id', galleryId);
      let lightbox = document.body.querySelector(
        `:scope > .gallery-lightbox[data-gallery-id="${galleryId}"]`
      ) as HTMLElement | null;
      if (!lightbox) {
        lightbox = container.querySelector('.gallery-lightbox') as HTMLElement | null;
        if (lightbox) {
          lightbox.setAttribute('data-gallery-id', galleryId);
          document.body.appendChild(lightbox);
        }
      }

      const lightboxImage = lightbox?.querySelector('.lightbox-image') as HTMLImageElement | null;
      const lightboxCaption = lightbox?.querySelector('.lightbox-caption') as HTMLElement | null;
      const lightboxClose = lightbox?.querySelector('.lightbox-close') as HTMLButtonElement | null;
      const lightboxPrev = lightbox?.querySelector('.lightbox-prev') as HTMLButtonElement | null;
      const lightboxNext = lightbox?.querySelector('.lightbox-next') as HTMLButtonElement | null;
      const lightboxContent = lightbox?.querySelector('.lightbox-content') as HTMLElement | null;

      if (!grid) return;

      const initialVisible = parseInt(grid.dataset.initialVisible || '8', 10);
      const items = grid.querySelectorAll('.gallery-item');
      const toggleText = toggle?.querySelector('.toggle-text');
      let currentIndex = 0;

      // See More toggle
      if (toggle) {
        toggle.addEventListener('click', () => {
          const isExpanded = toggle.dataset.expanded === 'true';

          items.forEach((item, index) => {
            if (index >= initialVisible) {
              item.classList.toggle('hidden', isExpanded);
            }
          });

          toggle.dataset.expanded = isExpanded ? 'false' : 'true';
          if (toggleText) {
            toggleText.textContent = isExpanded ? 'See More' : 'See Less';
          }
        });
      }

      // Lightbox functionality
      if (lightbox && lightboxImage && lightboxCaption) {
        const itemList = Array.from(items) as HTMLElement[];

        const showAtIndex = (index: number) => {
          const item = itemList[index];
          if (!item) return;
          currentIndex = index;
          lightboxImage.src = item.dataset.src || '';
          lightboxImage.alt = item.dataset.alt || '';
          lightboxCaption.textContent = item.dataset.alt || '';
        };

        const openLightbox = (index: number) => {
          showAtIndex(index);
          lightbox.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        };

        const closeLightbox = () => {
          lightbox.classList.add('hidden');
          lightboxImage.src = '';
          lightboxCaption.textContent = '';
          document.body.style.overflow = '';
        };

        const showNext = () => showAtIndex((currentIndex + 1) % itemList.length);
        const showPrev = () => showAtIndex((currentIndex - 1 + itemList.length) % itemList.length);

        // Click on gallery items to open lightbox
        itemList.forEach((item, index) => {
          item.addEventListener('click', () => openLightbox(index));
        });

        // Close button
        lightboxClose?.addEventListener('click', closeLightbox);

        // Prev / next controls
        lightboxPrev?.addEventListener('click', (e) => {
          e.stopPropagation();
          showPrev();
        });
        lightboxNext?.addEventListener('click', (e) => {
          e.stopPropagation();
          showNext();
        });

        // Click outside image to close
        lightboxContent?.addEventListener('click', (e) => {
          if (e.target === lightboxContent) {
            closeLightbox();
          }
        });

        // Keyboard navigation
        document.addEventListener('keydown', (e) => {
          if (lightbox.classList.contains('hidden')) return;
          if (e.key === 'Escape') closeLightbox();
          if (e.key === 'ArrowRight') showNext();
          if (e.key === 'ArrowLeft') showPrev();
        });
      }
    });
  }

  initGallery();
  document.addEventListener('astro:after-swap', initGallery);
</script>
