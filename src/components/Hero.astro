---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  title: string;
  description?: string;
  role?: string;
  location?: string;
  image?: { src: string | ImageMetadata; alt: string };
  imageDark?: { src: string | ImageMetadata; alt: string };
}

const { title, description, role, location, image, imageDark } = Astro.props as Props;
---

<section class="split-hero" data-reveal>
  {image && (
    <figure class="hero-photo m-0">
      {typeof image.src === 'string' ? (
        <img class="hero-logo-light" src={image.src} alt={image.alt} />
      ) : (
        <Image class="hero-logo-light" src={image.src} alt={image.alt} loading="eager" widths={[500, 900, 1300]} sizes="(max-width: 900px) 100vw, 55vw" />
      )}
      {imageDark && (
        typeof imageDark.src === 'string' ? (
          <img class="hero-logo-dark" src={imageDark.src} alt={imageDark.alt} />
        ) : (
          <Image class="hero-logo-dark" src={imageDark.src} alt={imageDark.alt} loading="eager" widths={[500, 900, 1300]} sizes="(max-width: 900px) 100vw, 55vw" />
        )
      )}
    </figure>
  )}

  <div class="hero-copy">
    <h1 class="hero-name">{title}</h1>
    {role && <p class="hero-role">{role}</p>}
    {(description || location) && (
      <p class="hero-tagline">{description}{description && location ? ' — ' : ''}{location}</p>
    )}
  </div>
</section>
