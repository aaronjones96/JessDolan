---
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import CustomCursor from '../components/CustomCursor.astro';
import { getSite } from '../utils/consts';

interface Props {
	title?: string;
	description?: string;
	image?: ImageMetadata;
	noindex?: boolean;
}

const site = await getSite();
const { title = site.author.name, description, image, noindex } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={title} description={description} image={image} noindex={noindex} />
    </head>
    <body>
        <CustomCursor />
        <Header />
        <main class="content-shell">
            <slot />
        </main>
        <Footer />
        <ScrollReveal />
    </body>
</html>